<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for Android 12 to 14: plain views a launcher can inflate for a RemoteViews
     provider, filled with fixed sample strings. Android 15 and later get a Glance-rendered one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/qashy_preview_background"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:padding="12dp">

  <FrameLayout
    android:layout_width="76dp"
    android:layout_height="76dp">
    <ImageView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:contentDescription="@string/qashy_preview_budget_percent"
      android:src="@drawable/qashy_preview_ring" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:text="@string/qashy_preview_budget_percent"
      android:textColor="@color/qashy_preview_text"
      android:textSize="16sp"
      android:textStyle="bold" />
  </FrameLayout>

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:text="@string/qashy_preview_budget_name"
      android:textColor="@color/qashy_preview_text"
      android:textSize="15sp"
      android:textStyle="bold" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:text="@string/qashy_preview_month"
      android:textColor="@color/qashy_preview_muted"
      android:textSize="11sp" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:maxLines="1"
      android:text="@string/qashy_preview_budget_remaining"
      android:textColor="@color/qashy_preview_text"
      android:textSize="14sp"
      android:textStyle="bold" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:text="@string/qashy_preview_budget_status"
      android:textColor="@color/qashy_preview_muted"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
