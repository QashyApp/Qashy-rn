{
  "expo": {
    "name": "Qashy",
    "slug": "qashy",
    "version": "3.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#E8E7F8",
    "scheme": "qashy",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5070FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "package": "com.venusddev.qashy"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Qashy — Calm Budgeting",
      "shortName": "Qashy",
      "themeColor": "#5070FF",
      "backgroundColor": "#E8E7F8"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8E7F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 108,
          "dark": {
            "backgroundColor": "#121221",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Qashy uses the camera only to scan the pairing code shown on another of your own devices. Nothing is recorded, stored, or sent anywhere.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e7487171-c787-48dc-aea9-736d63f07042"
      }
    },
    "owner": "venusddev"
  }
}
