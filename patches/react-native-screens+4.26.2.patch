@@ -0,0 +1,39 @@
+package com.swmansion.rnscreens.gamma.tabs.host.event
+
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.WritableMap
+import com.facebook.react.uimanager.events.Event
+import com.swmansion.rnscreens.gamma.common.event.NamingAwareEventType
+
+/**
+ * QASHY PATCH: dispatched to JS when the user long-presses a tab bar item.
+ * Never coalesced, every long press is delivered.
+ */
+class TabsHostTabLongPressEvent(
+    surfaceId: Int,
+    viewId: Int,
+    val screenKey: String,
+) : Event<TabsHostTabLongPressEvent>(surfaceId, viewId),
+    NamingAwareEventType {
+    override fun getEventName() = EVENT_NAME
+
+    override fun getEventRegistrationName() = EVENT_REGISTRATION_NAME
+
+    override fun canCoalesce(): Boolean = false
+
+    override fun getEventData(): WritableMap? =
+        Arguments.createMap().apply {
+            putString(EK_SCREEN_KEY, screenKey)
+        }
+
+    companion object : NamingAwareEventType {
+        const val EVENT_NAME = "topTabLongPress"
+        const val EVENT_REGISTRATION_NAME = "onTabLongPress"
+
+        private const val EK_SCREEN_KEY = "screenKey"
+
+        override fun getEventName() = EVENT_NAME
+
+        override fun getEventRegistrationName() = EVENT_REGISTRATION_NAME
+    }
+}
