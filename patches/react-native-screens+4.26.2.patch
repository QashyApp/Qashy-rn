+/**
+ * Qashy: a damped spring's step response as an interpolator, so the sheet rises the way a flung
+ * sheet would: off the mark at once, then settling softly. The platform default it replaces (300 ms
+ * accelerate-decelerate) spends its first frames barely moving, which reads as a delay, and its
+ * symmetric curve reads as linear. Clamped at the target, so the sheet never lifts off the bottom.
+ */
+internal class SpringInterpolator(
+    private val dampingRatio: Double,
+    private val durationSeconds: Double,
+) : TimeInterpolator {
+    // The envelope has decayed to e^-7.5 (0.06%) by the end, so finishing exactly on 1 is invisible.
+    private val omega = 7.5 / (dampingRatio * durationSeconds)
+    private val omegaDamped = omega * sqrt(1 - dampingRatio * dampingRatio)
+
+    override fun getInterpolation(input: Float): Float {
+        if (input >= 1f) return 1f
+        val t = input * durationSeconds
+        val envelope = exp(-dampingRatio * omega * t)
+        val progress =
+            1 - envelope * (cos(omegaDamped * t) + dampingRatio * omega / omegaDamped * sin(omegaDamped * t))
+        return min(progress.toFloat(), 1f)
+    }
+}
