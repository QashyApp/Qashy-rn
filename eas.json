{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "QASHY_ANDROID_ARCHS": "arm64-v8a"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "QASHY_ANDROID_ARCHS": "arm64-v8a"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "QASHY_ANDROID_ARCHS": "arm64-v8a,x86_64"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
